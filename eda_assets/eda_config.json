 "keywords_note": "stems = substrings that must occur (fast pre-filter); regex = exact match on lower-case text",
 "keywords": {
  "putin": {
   "stems": [
    "putin"
   ],
   "regex": "\\bputin"
  },
  "zelensky": {
   "stems": [
    "zelensk"
   ],
   "regex": "\\bzelensk"
  },
  "biden": {
   "stems": [
    "biden"
   ],
   "regex": "\\bbiden"
  },
  "trump": {
   "stems": [
    "trump"
   ],
   "regex": "\\btrump"
  },
  "nuclear": {
   "stems": [
    "nuclear",
    "nuke",
    "nuking"
   ],
   "regex": "\\bnuclear\\b|\\bnukes?\\b|\\bnuking\\b"
  },
  "negotiations": {
   "stems": [
    "negotiat",
    "peace",
    "cease"
   ],
   "regex": "\\bnegotiat|\\bpeace talks?\\b|\\bpeace deal|\\bpeace treaty|\\bcease-?fire"
  },
  "war_crimes": {
   "stems": [
    "war crim",
    "genocid",
    "atrocit",
    "massacre"
   ],
   "regex": "\\bwar crimes?\\b|\\bwar criminals?\\b|\\bgenocid|\\batrocit|\\bmassacre"
  },
  "mobilisation": {
   "stems": [
    "mobili"
   ],
   "regex": "\\bmobili[sz]"
  },
  "nazi": {
   "stems": [
    "nazi"
   ],
   "regex": "\\bnazis?\\b|\\bnazism\\b|\\bdenazif|\\bneo-?nazi"
  },
  "grain": {
   "stems": [
    "grain",
    "wheat",
    "food crisis",
    "famine"
   ],
   "regex": "\\bgrain\\b|\\bwheat\\b|\\bfood crisis|\\bfamine\\b"
  },
  "javelin": {
   "stems": [
    "javelin"
   ],
   "regex": "\\bjavelins?\\b"
  },
  "nlaw": {
   "stems": [
    "nlaw"
   ],
   "regex": "\\bnlaws?\\b"
  },
  "stinger": {
   "stems": [
    "stinger"
   ],
   "regex": "\\bstingers?\\b"
  },
  "bayraktar": {
   "stems": [
    "bayraktar",
    "tb2",
    "tb-2"
   ],
   "regex": "\\bbayraktars?\\b|\\btb-?2s?\\b"
  },
  "howitzers": {
   "stems": [
    "m777",
    "howitzer",
    "pzh"
   ],
   "regex": "\\bm777s?\\b|\\bhowitzers?\\b|\\bpzh ?2000|\\bcaesar howitzers?\\b"
  },
  "himars": {
   "stems": [
    "himars",
    "m142",
    "gmlrs"
   ],
   "regex": "\\bhimars\\b|\\bm142\\b|\\bgmlrs\\b"
  },
  "shahed": {
   "stems": [
    "shahed",
    "geran",
    "kamikaze drone",
    "iranian drone"
   ],
   "regex": "\\bshaheds?\\b|\\bgeran-?2\\b|\\bkamikaze drones?\\b|\\biranian drones?\\b"
  },
  "patriot": {
   "stems": [
    "patriot"
   ],
   "regex": "\\bpatriot (?:missile|system|batter|air defen|launcher)|\\bpatriots? (?:to|for) ukraine"
  },
  "tanks": {
   "stems": [
    "leopard",
    "abrams",
    "challenger",
    "western tank"
   ],
   "regex": "\\bleopard ?2s?\\b|\\bleopards\\b|\\babrams\\b|\\bchallenger ?2s?\\b|\\bwestern tanks\\b"
  },
  "jets": {
   "stems": [
    "f16",
    "f-16",
    "fighter jet",
    "mig29",
    "mig-29"
   ],
   "regex": "\\bf-?16s?\\b|\\bfighter jets?\\b|\\bmig-?29s?\\b"
  }
